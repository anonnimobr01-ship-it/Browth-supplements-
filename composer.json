{
  "name": "browth/supplements",
  "description": "BROWTH — API PHP, Firebase Auth e Supabase",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "kreait/firebase-php": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Browth\\": "src/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public router.php",
    "test": "php tests/validation.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.2.0"
    }
  }
}
